    { "src": "/screenshots/home-wide.png", "sizes": "1280x720", "type": "image/png", "form_factor": "wide", "label": "Den Collective on a tablet or desktop" }
  ],
  "shortcuts": [
    { "name": "Start a photo strip", "short_name": "Get started", "url": "/?source=shortcut", "icons": [{ "src": "/icon-192.png?v=5", "sizes": "192x192", "type": "image/png" }] }
  ]
